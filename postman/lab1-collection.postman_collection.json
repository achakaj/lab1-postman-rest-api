                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            },
            "description": "Supprime (simulation) le produit. La réponse contient isDeleted=true et deletedOn."
          }
        }
      ]
    },
    {
      "name": "05 - Chaînage",
      "item": [
        {
          "name": "Login (stocke accessToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Content-Type est JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"Temps de réponse < 500 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(500); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Body: accessToken présent\", function () { pm.expect(json.accessToken).to.be.a(\"string\").and.not.empty; });",
                  "pm.test(\"Body: username correct\", function () { pm.expect(json.username).to.eql(pm.environment.get(\"username\")); });",
                  "pm.environment.set(\"accessToken\", json.accessToken);",
                  "pm.environment.set(\"userId\", json.id);",
                  "pm.test(\"accessToken stocké dans l'environnement\", function () { pm.expect(pm.environment.get(\"accessToken\")).to.eql(json.accessToken); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Authentification ; le accessToken est stocké dans l'environnement via pm.environment.set pour la requête suivante.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"expiresInMins\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Profil connecté (Bearer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Content-Type est JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"Temps de réponse < 500 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(500); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Body: profil de l'utilisateur connecté\", function () { pm.expect(json.username).to.eql(pm.environment.get(\"username\")); pm.expect(json).to.include.keys(\"id\", \"email\", \"firstName\", \"lastName\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Utilise le token via l'en-tête Authorization: Bearer {{accessToken}}."
          }
        }
      ]
    },
