    {
      "name": "03 - PUT vs PATCH",
      "item": [
        {
          "name": "PUT - remplacement",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Content-Type est JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"Temps de réponse < 500 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(500); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Body: title mis à jour\", function () { pm.expect(json.title).to.eql(\"Produit remplacé (PUT)\"); });",
                  "pm.test(\"Body: id conservé\", function () { pm.expect(json.id).to.eql(parseInt(pm.environment.get(\"productId\"))); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            },
            "description": "PUT = remplacement COMPLET de la ressource : le client envoie la représentation entière ; les champs omis sont censés être écrasés/supprimés. Idempotent.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Produit remplacé (PUT)\",\n  \"price\": 150,\n  \"category\": \"smartphones\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "PATCH - modification partielle",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Content-Type est JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"Temps de réponse < 500 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(500); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Body: price mis à jour\", function () { pm.expect(json.price).to.eql(79.5); });",
                  "pm.test(\"Body: les autres champs sont conservés\", function () { pm.expect(json).to.have.property(\"title\"); pm.expect(json.title).to.be.a(\"string\").and.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            },
            "description": "PATCH = modification PARTIELLE : seuls les champs envoyés sont modifiés, les autres restent inchangés (ici seul le prix). Différence avec PUT : PUT remplace tout, PATCH ne touche que ce qui est envoyé.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 79.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "04 - DELETE",
      "item": [
        {
          "name": "Suppression d'un produit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Content-Type est JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
