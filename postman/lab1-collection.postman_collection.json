{
  "info": {
    "name": "Lab 1 - API REST avec Postman (DummyJSON)",
    "description": "Lab 1 : Conception et test d'une API REST avec HTTP et Postman. API de démo : https://dummyjson.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - GET",
      "item": [
        {
          "name": "Liste des produits",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Content-Type est JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"Temps de réponse < 500 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(500); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Body: products est un tableau non vide\", function () { pm.expect(json.products).to.be.an(\"array\").that.is.not.empty; });",
                  "pm.test(\"Body: total, skip, limit présents\", function () { pm.expect(json).to.include.keys(\"total\", \"skip\", \"limit\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "description": "Récupère la liste paginée par défaut (30 produits)."
          }
        },
        {
          "name": "Produit par id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Content-Type est JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"Temps de réponse < 500 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(500); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Body: id correspond à productId\", function () { pm.expect(json.id).to.eql(parseInt(pm.environment.get(\"productId\"))); });",
                  "pm.test(\"Body: champs title et price\", function () { pm.expect(json).to.have.property(\"title\"); pm.expect(json.price).to.be.a(\"number\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            },
            "description": "Récupère un produit par son identifiant."
          }
        },
        {
          "name": "Recherche (q=phone)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Content-Type est JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"Temps de réponse < 500 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(500); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Body: résultats trouvés\", function () { pm.expect(json.products).to.be.an(\"array\").that.is.not.empty; pm.expect(json.total).to.be.above(0); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/search?q=phone",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "phone"
                }
              ]
            },
            "description": "Recherche plein texte de produits contenant « phone »."
          }
        },
        {
          "name": "Pagination (limit, skip, select)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Content-Type est JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"Temps de réponse < 500 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(500); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Body: limit=5 et skip=10\", function () { pm.expect(json.products).to.have.lengthOf(5); pm.expect(json.limit).to.eql(5); pm.expect(json.skip).to.eql(10); });",
                  "pm.test(\"Body: seuls id, title, price sont renvoyés\", function () { json.products.forEach(p => pm.expect(p).to.have.all.keys(\"id\", \"title\", \"price\")); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?limit=5&skip=10&select=title,price",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "skip",
                  "value": "10"
                },
                {
                  "key": "select",
                  "value": "title,price"
                }
              ]
            },
            "description": "Pagination avec limit/skip et projection des champs avec select."
          }
        },
        {
          "name": "Tri (sortBy, order)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Content-Type est JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"Temps de réponse < 500 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(500); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Body: prix triés par ordre croissant\", function () { const prices = json.products.map(p => p.price); pm.expect(prices).to.eql([...prices].sort((a, b) => a - b)); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?sortBy=price&order=asc&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "sortBy",
                  "value": "price"
                },
                {
                  "key": "order",
                  "value": "asc"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Tri des produits par prix croissant."
          }
        },
        {
          "name": "Liste des catégories",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Content-Type est JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"Temps de réponse < 500 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(500); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Body: tableau non vide d'objets catégorie\", function () { pm.expect(json).to.be.an(\"array\").that.is.not.empty; pm.expect(json[0]).to.include.keys(\"slug\", \"name\", \"url\"); });",
                  "pm.test(\"Body: smartphones existe\", function () { pm.expect(json.map(c => c.slug)).to.include(\"smartphones\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "categories"
              ]
            },
            "description": "Liste de toutes les catégories (objets slug/name/url)."
          }
        },
        {
          "name": "Produits de la catégorie smartphones",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Content-Type est JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"Temps de réponse < 500 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(500); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Body: tous les produits sont des smartphones\", function () { pm.expect(json.products).to.be.an(\"array\").that.is.not.empty; json.products.forEach(p => pm.expect(p.category).to.eql(\"smartphones\")); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/category/smartphones",
